# DiscordPHP-Newsletter configuration. Copy to `.env` and fill in:   cp env.example .env
#
# Only placeholders here; never commit real tokens. A variable already set in the
# environment wins over `.env`. Comments must be on their own line: everything
# after `=` is read as the value.

# --- Discord ---------------------------------------------------------------------

# Bot token. The bot needs the "Message Content Intent" enabled in the developer portal.
TOKEN=
# Your Discord user id: drafts are DM'd here, and only you can approve them.
OWNER_ID=
# Channel in your Valgorithms guild the approved newsletter is posted to.
NEWSLETTER_CHANNEL_ID=
# Servers to track, comma-separated (e.g. DiscordPHP, Valgorithms). Empty = every server the bot is in.
DISCORD_GUILD_IDS=
# Channels never recorded (staff-only, private, off-topic…), comma-separated.
DISCORD_IGNORE_CHANNEL_IDS=
# 1 = count joins/leaves. Needs the privileged "Server Members Intent".
DISCORD_TRACK_MEMBERS=0
# 1 = include your moderation actions from the audit log (bot needs View Audit Log).
DISCORD_AUDIT_LOG=1

# --- Schedule --------------------------------------------------------------------

# Local time the daily edition is drafted and DM'd to you, HH:MM.
NEWSLETTER_TIME=18:00
# IANA time zone for the schedule and "today". America/New_York follows EST/EDT;
# use Etc/GMT+5 for fixed UTC-5 all year. Empty = PHP's default.
NEWSLETTER_TIMEZONE=America/New_York
# 1 = on startup, draft the edition missed while the bot was offline.
NEWSLETTER_CATCH_UP=1

# --- Writing -----------------------------------------------------------------------

# Who the newsletter is about/signed by.
NEWSLETTER_AUTHOR=Valithor
# first ("I shipped…") or third ("Valithor shipped…").
NEWSLETTER_VOICE=first
# Rough target length in words.
NEWSLETTER_WORDS=350
# Extra free-form style guidance for the model. Optional.
NEWSLETTER_STYLE=
# 0 skips the fact-check pass (faster on a slow model).
NEWSLETTER_FACT_CHECK=1

# --- Local LLM (Ollama) ---------------------------------------------------------------

# Required. A bare origin (http://localhost:11434) uses Ollama's native API;
# a trailing /v1 (http://localhost:11434/v1) uses the OpenAI-compatible one.
OLLAMA_URL=http://localhost:11434
# A tag from `ollama list`.
OLLAMA_MODEL=gemma3:27b
# Context window to request, in tokens (native mode only).
OLLAMA_NUM_CTX=32768
# Per-request timeout, in seconds. Local models writing ~400 words can be slow.
OLLAMA_TIMEOUT=300
# 0 skips a thinking model's reasoning pass, 1 forces it; empty = the model's default.
OLLAMA_THINK=

# --- GitHub ---------------------------------------------------------------------------

# Your GitHub login.
GITHUB_USERNAME=valzargaming
# Personal access token (read-only is plenty). Strongly recommended: without one GitHub
# allows 60 requests an hour, and each edition looks up PR titles and push commits.
# It also lets the events feed include activity only you can see.
GITHUB_TOKEN=
# 1 = include private-repository activity. Off by default so private repo names
# never reach a public channel.
GITHUB_INCLUDE_PRIVATE=0

# --- Websites -------------------------------------------------------------------------

# Where approved editions are also published, comma-separated owner/repo[@branch]:path.
# Each site renders the JSON file on its Newsletter page and redeploys on the push.
# Empty = Discord only.
PUBLISH_TARGETS=discord-php/DiscordPHP.org:data/newsletter.json,valzargaming/valgorithms.com:site/data/newsletter.json
# Token with Contents read/write on those repositories. Empty = GITHUB_TOKEN is used.
# A fine-grained token covers one owner, so give each owner its own if needed:
# PUBLISH_GITHUB_TOKEN_<OWNER> (upper-cased, other characters as _) wins over
# PUBLISH_GITHUB_TOKEN. A classic token with `repo` scope covers both.
# At startup the bot logs whether each site is writable with the token it will use.
PUBLISH_GITHUB_TOKEN=
PUBLISH_GITHUB_TOKEN_DISCORD_PHP=
PUBLISH_GITHUB_TOKEN_VALZARGAMING=

# --- Steam ------------------------------------------------------------------------------

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 64-bit SteamID (7656…). Profile "Game details" must be Public.
STEAM_ID=
